Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"B1", "[", "t", "]"}], "]"}], "/", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", 
           RowBox[{"1", "-", "b"}]], "-", 
          RowBox[{"b", " ", 
           SuperscriptBox["St", "2"]}], "+", 
          RowBox[{"I", " ", 
           FractionBox[
            RowBox[{"b", " ", "St"}], 
            RowBox[{"1", "-", "b"}]]}]}], ")"}], 
        RowBox[{"Conjugate", "[", 
         RowBox[{"B3", "[", "t", "]"}], "]"}]}], "]"}]}], "/.", 
     RowBox[{"solB", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "200"}], "}"}], ",", 
