Cell["\<\
Case 1: parameters are such that the variable B1 quickly decays to zero, \
leaving us with a reduced system for the variable B3 that can be further \
simplified: a constant of motion can be found. \
\>", "Text",
 CellChangeTimes->{{3.989895221128921*^9, 3.9898952745476933`*^9}, {
  3.990022118880381*^9, 
  3.990022133932907*^9}},ExpressionUUID->"918523a0-0eb2-4bbf-bafc-\
8aeb3bf0ef44"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"St", "=", "0.1"}], ";", 
  RowBox[{"b", "=", "0.99"}], ";", 
  RowBox[{"\[Epsilon]", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Mtemp", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"-", 
      RowBox[{"St", "^", "2"}]}], "\[Epsilon]"], "+", 
    FractionBox["1", 
     RowBox[{"\[Epsilon]", 
      RowBox[{"(", 
       RowBox[{"1", "-", "b"}], ")"}]}]], "-", 
    RowBox[{"I", " ", 
     FractionBox["St", 
      RowBox[{"\[Epsilon]", 
       RowBox[{"(", 
        RowBox[{"1", "-", "b"}], ")"}]}]]}]}]}], ";", 
  RowBox[{"\[Sigma]0", "=", "1."}], ";", 
  RowBox[{"\[Omega]0", "=", 
   RowBox[{"1", "/", "Mtemp"}]}], ";", 
  RowBox[{"solB", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"eqsB", "/.", "replFull"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"B1", "[", "0", "]"}], "==", 
          RowBox[{"\[Omega]0", "-", 
           RowBox[{
            RowBox[{"Conjugate", "[", "\[Sigma]0", "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              FractionBox[
               RowBox[{"-", 
                SuperscriptBox["St", "2"]}], "\[Epsilon]"], "+", 
              FractionBox["1", 
               RowBox[{"\[Epsilon]", 
                RowBox[{"(", 
                 RowBox[{"1", "-", "b"}], ")"}]}]], "-", 
              RowBox[{"I", " ", 
               FractionBox["St", 
                RowBox[{"\[Epsilon]", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "b"}], ")"}]}]]}]}], ")"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"B3", "[", "0", "]"}], "==", 
          RowBox[{
           RowBox[{"Conjugate", "[", "\[Sigma]0", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{
             FractionBox[
              RowBox[{"-", 
               SuperscriptBox["St", "2"]}], "\[Epsilon]"], "+", 
             FractionBox["1", 
              RowBox[{"\[Epsilon]", 
               RowBox[{"(", 
                RowBox[{"1", "-", "b"}], ")"}]}]], "-", 
             RowBox[{"I", " ", 
              FractionBox["St", 
               RowBox[{"\[Epsilon]", 
                RowBox[{"(", 
                 RowBox[{"1", "-", "b"}], ")"}]}]]}]}], ")"}]}]}]}], "}"}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"B1", "[", "t", "]"}], ",", 
       RowBox[{"B3", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10000"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"solBman", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"eqsBman", "/.", "replFull"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"B3", "[", "0", "]"}], "==", 
         RowBox[{
          RowBox[{"Conjugate", "[", "\[Sigma]0", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"-", 
              SuperscriptBox["St", "2"]}], "\[Epsilon]"], "+", 
            FractionBox["1", 
             RowBox[{"\[Epsilon]", 
              RowBox[{"(", 
               RowBox[{"1", "-", "b"}], ")"}]}]], "-", 
            RowBox[{"I", " ", 
             FractionBox["St", 
              RowBox[{"\[Epsilon]", 
               RowBox[{"(", 
                RowBox[{"1", "-", "b"}], ")"}]}]]}]}], ")"}]}]}], "}"}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"B3", "[", "t", "]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10000"}], "}"}]}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.9898941157967157`*^9, 3.989894199966655*^9}, {
   3.98989449112223*^9, 3.989894581074716*^9}, {3.989894614520997*^9, 
